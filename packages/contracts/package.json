{
  "name": "@sdb/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared Zod schemas, enums, and constants for the Staffing Done Better Portal (api + web).",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
